# Virtual environment
qiskit_env/
venv/
env/
.venv/
# uv (the lockfile uv.lock IS committed for reproducibility)
.uv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Auto-generated by setuptools_scm (regenerated on every build)
src/_version.py

# Jupyter Notebook
.ipynb_checkpoints

# Logs and results (optional, if you don't want to track generated logs/results)
# logs/
results/

# Environment variables / secrets
.env
.env.*

# Temporary and system files
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db
.hypothesis/

# Node / Expo / Turborepo
node_modules/
.expo/
.turbo/
apps/client/ios/
apps/client/android/
apps/client/.expo/
*.tsbuildinfo
pnpm-lock.yaml

# MkDocs build output
site/

# Linter / type-checker caches
.ruff_cache/
.mypy_cache/

# Coverage artifacts
.coverage
coverage.xml
htmlcov/

# Private context (session notes, not for repo)
.context/

# Agent scratch workspace: track the skeleton (README, AGENTS.md, .gitkeep),
# ignore the ephemeral content agents write into the subfolders.
# (the !**/ line lets git descend into subdirs so the .gitkeep negation applies)
.agent-workspace/**
!.agent-workspace/**/
!.agent-workspace/README.md
!.agent-workspace/AGENTS.md
!.agent-workspace/**/.gitkeep
