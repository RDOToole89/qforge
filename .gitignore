# Virtual environment
qiskit_env/
venv/
env/
.venv/
# uv (the lockfile uv.lock IS committed for reproducibility)
.uv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Auto-generated by setuptools_scm (regenerated on every build)
src/_version.py

# Jupyter Notebook
.ipynb_checkpoints

# Generated experiment output (never committed)
logs/
results/

# Environment variables / secrets
.env
.env.*

# Temporary and system files
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db
.hypothesis/

# Node / Expo / Turborepo
node_modules/
.expo/
.turbo/
apps/client/ios/
apps/client/android/
apps/client/.expo/
*.tsbuildinfo
# pnpm-lock.yaml is committed for reproducible, deterministic installs.

# MkDocs build output
site/

# Linter / type-checker caches
.ruff_cache/
.mypy_cache/

# Coverage artifacts
.coverage
coverage.xml
htmlcov/

# Private context (session notes, not for repo)
.context/

# Agent scratch workspace (local only)
.agent-workspace/
