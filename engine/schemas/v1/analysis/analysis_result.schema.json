{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "analysis_result.schema.json",
  "title": "AnalysisResult",
  "description": "Analysis of structured decoherence from experiment results",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "analysis_id": {
      "type": "string"
    },
    "analysis_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Time this analysis was performed"
    },
    "methodology": {
      "type": "string",
      "description": "Optional description or label of analysis method (e.g., 'entropy_sweep', 'mutual_information_profile')"
    },
    "input_experiments": {
      "type": "array",
      "minItems": 1,
      "description": "Experiment identifiers or embedded experiment results",
      "items": {
        "anyOf": [
          { "type": "string" },
          { "$ref": "../execution/experiment_result.schema.json" }
        ]
      }
    },
    "structure_metrics": {
      "$ref": "../core/structure_metrics.schema.json"
    },
    "conclusions": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 10000
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "version": {
          "type": "string",
          "description": "Optional version for the conclusions structure"
        }
      },
      "required": ["summary"]
    },
    "provenance": {
      "$ref": "../core/provenance.schema.json"
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "input_experiments",
    "structure_metrics",
    "conclusions",
    "provenance"
  ]
}
