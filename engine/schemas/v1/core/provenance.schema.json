{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "provenance.schema.json",
  "title": "Provenance",
  "description": "Execution provenance metadata to track reproducibility and context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Schema version for this specification"
    },
    "engine_config_hash": {
      "type": "string",
      "description": "Hash of engine/runtime configuration at execution"
    },
    "git_commit": {
      "type": "string",
      "description": "Git commit hash of the codebase used"
    },
    "execution_backend": {
      "type": "string",
      "description": "Backend used (e.g., qasm_simulator, ibmq_quito)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Execution time in ISO-8601 format"
    },
    "environment": {
      "type": "object",
      "description": "Optional environment metadata (library versions, platform, etc.)",
      "additionalProperties": true
    },
    "author": {
      "type": "string",
      "description": "Optional human-readable name of experiment author"
    },
    "institution": {
      "type": "string",
      "description": "Optional institution or lab affiliation"
    },
    "notes": {
      "type": "string",
      "description": "Optional freeform notes for context"
    }
  },
  "required": [
    "schema_version",
    "engine_config_hash",
    "execution_backend",
    "timestamp"
  ]
}
