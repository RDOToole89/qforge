{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "experiment_result.schema.json",
  "title": "ExperimentResult",
  "description": "Results of a quantum experiment execution",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "experiment_id": { "type": "string" },
    "run_number": { "type": "integer", "minimum": 1 },
    "success": { "type": "boolean" },
    "spec_snapshot": { "$ref": "../core/experiment_spec.schema.json" },
    "provenance": { "$ref": "../core/provenance.schema.json" },
    "raw_counts": {
      "type": "object",
      "patternProperties": {
        "^[01]+$": { "type": "integer", "minimum": 0 }
      }
    },
    "empirical_frequencies": {
      "type": "object",
      "patternProperties": {
        "^[01]+$": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "ideal_distribution": {
      "type": ["object", "null"],
      "patternProperties": {
        "^[01]+$": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "qubit_ordering": { "type": "array", "items": { "type": "integer" } },
    "structure_metrics": { "$ref": "../core/structure_metrics.schema.json" },
    "top_pathways": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "evidence_summary": {
      "type": "object",
      "properties": {
        "supports_structure": { "type": "boolean" },
        "supports_randomness": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "n_shots": { "type": "integer" }
      }
    }
  },
  "required": [
    "experiment_id",
    "run_number",
    "success",
    "spec_snapshot",
    "structure_metrics",
    "provenance"
  ]
}
