{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sweep_manifest.schema.json",
  "title": "SweepManifest",
  "description": "Parameter sweep specification for systematic studies",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Schema version identifier"
    },
    "sweep_id": {
      "type": "string",
      "description": "Unique identifier for the sweep"
    },
    "base_config": {
      "$ref": "../core/experiment_spec.schema.json",
      "description": "Base experiment configuration to sweep around"
    },
    "parameter_ranges": {
      "type": "object",
      "description": "Mapping of parameter name → list of values to sweep over",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": ["number", "string", "boolean"],
          "description": "Single value for sweep dimension (numeric or categorical)"
        },
        "minItems": 1
      }
    },
    "runs_per_config": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "Number of runs per parameter combination"
    },
    "seed_strategy": {
      "type": "string",
      "enum": ["fixed_increment", "explicit_list", "random"],
      "default": "fixed_increment",
      "description": "Strategy for assigning random seeds to runs"
    },
    "base_seed": {
      "type": ["integer", "null"],
      "description": "Base seed for reproducibility (used with fixed_increment)"
    },
    "explicit_seeds": {
      "type": ["array", "null"],
      "description": "Explicit list of seeds to use (only for explicit_list strategy)",
      "items": { "type": "integer" }
    },
    "research_metadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional metadata to link sweep to research goals",
      "properties": {
        "hypothesis": { "type": "string" },
        "phase": {
          "type": "string",
          "enum": [
            "structure_validation",
            "threshold_mapping",
            "topology_dependence",
            "noise_comparison",
            "predictive_validation"
          ]
        },
        "expected_trends": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Qualitative expectations about results"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "description": "Execution parameters for running the sweep",
      "properties": {
        "parallel": { "type": "boolean", "default": false },
        "max_concurrent": { "type": "integer", "minimum": 1, "maximum": 64 },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "$ref": "../core/provenance.schema.json",
      "description": "Provenance metadata for this sweep"
    }
  },
  "required": [
    "schema_version",
    "sweep_id",
    "base_config",
    "parameter_ranges",
    "runs_per_config",
    "seed_strategy",
    "provenance"
  ]
}
