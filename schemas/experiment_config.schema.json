{
  "additionalProperties": false,
  "properties": {
    "num_qubits": {
      "title": "Num Qubits",
      "type": "integer"
    },
    "state_type": {
      "enum": [
        "GHZ",
        "W",
        "CLUSTER",
        "BELL",
        "SUPERPOSITION",
        "CUSTOM"
      ],
      "title": "State Type",
      "type": "string"
    },
    "sim_mode": {
      "default": "qasm",
      "enum": [
        "qasm",
        "density"
      ],
      "title": "Sim Mode",
      "type": "string"
    },
    "shots": {
      "default": 1024,
      "title": "Shots",
      "type": "integer"
    },
    "noise_enabled": {
      "default": false,
      "title": "Noise Enabled",
      "type": "boolean"
    },
    "noise_type": {
      "anyOf": [
        {
          "enum": [
            "depolarizing",
            "amplitude_damping",
            "phase_damping",
            "bit_flip",
            "phase_flip",
            "thermal_relaxation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Noise Type"
    },
    "error_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Rate"
    },
    "rng_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rng Seed"
    },
    "custom_params": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Custom Params"
    },
    "enable_research_metrics": {
      "default": false,
      "title": "Enable Research Metrics",
      "type": "boolean",
      "description": "Enable computation of structured decoherence pathway metrics (AI, PCR, EEC, TPS, CES)"
    },
    "research_type": {
      "anyOf": [
        {
          "enum": [
            "structured_decoherence",
            "parameter_sweep",
            "noise_comparison",
            "control",
            "scaling",
            "convergence",
            "batch_sweep"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Research Type",
      "description": "Type of research analysis to perform"
    },
    "multiple_runs": {
      "default": 1,
      "minimum": 1,
      "title": "Multiple Runs",
      "type": "integer",
      "description": "Number of experimental runs for statistical validation"
    },
    "track_convergence": {
      "default": false,
      "title": "Track Convergence",
      "type": "boolean",
      "description": "Enable convergence tracking for high-precision experiments"
    },
    "visualization_type": {
      "default": "histogram",
      "enum": [
        "histogram",
        "density_matrix",
        "research",
        "plot",
        "none"
      ],
      "title": "Visualization Type",
      "type": "string",
      "description": "Type of visualization to generate"
    }
  },
  "required": [
    "num_qubits",
    "state_type"
  ],
  "title": "ExperimentConfig",
  "type": "object"
}