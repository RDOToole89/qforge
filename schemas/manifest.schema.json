{
  "$defs": {
    "ExperimentConfig": {
      "additionalProperties": false,
      "description": "Complete quantum experiment configuration.\n\nThis model defines all parameters needed to run a quantum experiment,\nfrom basic circuit parameters to advanced research configurations.",
      "properties": {
        "num_qubits": {
          "description": "Number of qubits in the quantum circuit",
          "maximum": 20,
          "minimum": 1,
          "title": "Num Qubits",
          "type": "integer"
        },
        "state_type": {
          "description": "Type of quantum state to prepare",
          "enum": [
            "GHZ",
            "W",
            "CLUSTER",
            "BELL",
            "SUPERPOSITION",
            "CUSTOM"
          ],
          "title": "State Type",
          "type": "string"
        },
        "sim_mode": {
          "default": "qasm",
          "description": "Simulation mode: 'qasm' for shot-based, 'density' for density matrix",
          "enum": [
            "qasm",
            "density"
          ],
          "title": "Sim Mode",
          "type": "string"
        },
        "shots": {
          "default": 1024,
          "description": "Number of measurement shots for qasm simulation",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Shots",
          "type": "integer"
        },
        "noise_enabled": {
          "default": false,
          "description": "Whether to apply noise to the quantum circuit",
          "title": "Noise Enabled",
          "type": "boolean"
        },
        "noise_type": {
          "anyOf": [
            {
              "enum": [
                "depolarizing",
                "amplitude_damping",
                "phase_damping",
                "bit_flip",
                "phase_flip",
                "thermal_relaxation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Type of noise model to apply",
          "title": "Noise Type"
        },
        "error_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Error rate for noise models (0.0 = no noise, 1.0 = maximum noise)",
          "title": "Error Rate"
        },
        "z_prob": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Z Prob"
        },
        "i_prob": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "I Prob"
        },
        "t1": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T1"
        },
        "t2": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T2"
        },
        "enable_research_metrics": {
          "default": false,
          "description": "Enable computation of structured decoherence pathway metrics (AI, PCR, EEC, TPS, CES)",
          "title": "Enable Research Metrics",
          "type": "boolean"
        },
        "research_type": {
          "anyOf": [
            {
              "enum": [
                "structured_decoherence",
                "parameter_sweep",
                "noise_comparison",
                "control",
                "scaling",
                "convergence",
                "batch_sweep"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Type of research analysis to perform",
          "title": "Research Type"
        },
        "multiple_runs": {
          "default": 1,
          "description": "Number of experimental runs for statistical validation",
          "maximum": 1000,
          "minimum": 1,
          "title": "Multiple Runs",
          "type": "integer"
        },
        "track_convergence": {
          "default": false,
          "description": "Enable convergence tracking for high-precision experiments",
          "title": "Track Convergence",
          "type": "boolean"
        },
        "visualization_type": {
          "default": "histogram",
          "description": "Type of visualization to generate",
          "enum": [
            "histogram",
            "density_matrix",
            "research",
            "plot",
            "none"
          ],
          "title": "Visualization Type",
          "type": "string"
        },
        "rng_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Random number generator seed for reproducible results",
          "title": "Rng Seed"
        },
        "custom_params": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom parameters for advanced state preparation or noise models",
          "title": "Custom Params"
        }
      },
      "required": [
        "num_qubits",
        "state_type"
      ],
      "title": "ExperimentConfig",
      "type": "object"
    },
    "SweepResearchMetadata": {
      "description": "Research-specific metadata for parameter sweeps.",
      "properties": {
        "hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Research hypothesis being tested by this sweep",
          "title": "Hypothesis"
        },
        "research_phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Phase of research (exploration, validation, optimization, etc.)",
          "title": "Research Phase"
        },
        "expected_trends": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected trends or relationships in the parameter space",
          "title": "Expected Trends"
        },
        "significance_level": {
          "default": 0.05,
          "description": "Required statistical significance level",
          "maximum": 0.1,
          "minimum": 0.001,
          "title": "Significance Level",
          "type": "number"
        },
        "minimum_effect_size": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum effect size of interest",
          "title": "Minimum Effect Size"
        },
        "correlation_analysis": {
          "default": true,
          "description": "Perform correlation analysis between parameters and metrics",
          "title": "Correlation Analysis",
          "type": "boolean"
        },
        "trend_analysis": {
          "default": true,
          "description": "Perform trend analysis across parameter ranges",
          "title": "Trend Analysis",
          "type": "boolean"
        },
        "statistical_tests": {
          "description": "Statistical tests to perform on sweep results",
          "items": {
            "type": "string"
          },
          "title": "Statistical Tests",
          "type": "array"
        }
      },
      "title": "SweepResearchMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete specification for a parameter sweep.\n\nDefines the base configuration and parameter ranges for systematic\nexploration of quantum experiment parameter space.",
  "properties": {
    "base_preset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Base preset name (legacy support, prefer base_config)",
      "title": "Base Preset"
    },
    "base_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExperimentConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Base experiment configuration (preferred over base_preset)"
    },
    "parameter_ranges": {
      "additionalProperties": {
        "items": {},
        "type": "array"
      },
      "description": "Parameter ranges to sweep: {parameter_name: [values]}",
      "title": "Parameter Ranges",
      "type": "object"
    },
    "runs_per_config": {
      "default": 1,
      "description": "Number of runs per parameter combination for statistical analysis",
      "maximum": 100,
      "minimum": 1,
      "title": "Runs Per Config",
      "type": "integer"
    },
    "rng_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Base random seed (incremented for each run)",
      "title": "Rng Seed"
    },
    "override": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Parameters to override in base configuration for all sweep runs",
      "title": "Override"
    },
    "research_metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/SweepResearchMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Research-specific metadata for parameter sweeps"
    },
    "parallel_execution": {
      "default": false,
      "description": "Enable parallel execution of sweep combinations",
      "title": "Parallel Execution",
      "type": "boolean"
    },
    "max_concurrent": {
      "anyOf": [
        {
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Maximum concurrent experiments (if parallel_execution=True)",
      "title": "Max Concurrent"
    },
    "timeout_seconds": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Timeout per experiment in seconds",
      "title": "Timeout Seconds"
    }
  },
  "required": [
    "parameter_ranges"
  ],
  "title": "SweepManifest",
  "type": "object"
}