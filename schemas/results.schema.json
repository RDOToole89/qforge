{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qexp.local/schemas/results.schema.json",
  "title": "Quantum Experiment Results",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_metadata",
    "experiment_parameters",
    "measurement_results"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "experiment_metadata": {
      "type": "object",
      "required": [
        "experiment_id",
        "timestamp",
        "framework_version",
        "research_type"
      ],
      "properties": {
        "experiment_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "framework_version": { "type": "string" },
        "research_type": { "type": "string" }
      }
    },
    "experiment_parameters": {
      "type": "object",
      "required": ["num_qubits", "state_type", "shots", "sim_mode"],
      "properties": {
        "num_qubits": { "type": "integer", "minimum": 1 },
        "state_type": { "type": "string" },
        "noise_type": { "type": "string" },
        "noise_enabled": { "type": "boolean" },
        "error_rate": { "type": ["number", "null"] },
        "shots": { "type": "integer", "minimum": 1 },
        "sim_mode": { "type": "string", "enum": ["qasm", "density"] }
      }
    },
    "measurement_results": {
      "type": "object",
      "required": ["raw_counts", "total_shots"],
      "properties": {
        "raw_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "total_shots": { "type": "integer", "minimum": 0 },
        "unique_outcomes": { "type": "integer", "minimum": 0 },
        "outcome_probabilities": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    },
    "research_metrics": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": true
}
