{
  "$defs": {
    "ArtifactRef": {
      "properties": {
        "kind": {
          "default": "other",
          "enum": [
            "histogram",
            "density_matrix",
            "hypergraph",
            "report",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "metadata": {
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "software_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Software Versions",
          "type": "object"
        },
        "host_info": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Host Info",
          "type": "object"
        },
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "rng_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rng Seed"
        },
        "simulator_info": {
          "title": "Simulator Info",
          "type": "object"
        },
        "transpilation_summary": {
          "title": "Transpilation Summary",
          "type": "object"
        }
      },
      "required": [
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "analysis": {
      "title": "Analysis",
      "type": "object"
    },
    "metrics": {
      "title": "Metrics",
      "type": "object"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "timestamp": {
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "analysis",
    "metrics",
    "provenance",
    "config_hash",
    "timestamp"
  ],
  "title": "ExperimentResult",
  "type": "object"
}